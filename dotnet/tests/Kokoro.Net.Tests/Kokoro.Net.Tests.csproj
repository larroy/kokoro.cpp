<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <KokoroNativeDir Condition="'$(KokoroNativeDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\artifacts\natives\$(NETCoreSdkRuntimeIdentifier)\</KokoroNativeDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kokoro.Net\Kokoro.Net.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(KokoroNativeDir)kokoro.dll;$(KokoroNativeDir)onnxruntime.dll" Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- BeforeBuild, not Build: Build's DependsOnTargets (CoreBuild) would copy the missing files first. -->
  <Target Name="KokoroCheckNatives" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(KokoroNativeDir)kokoro.dll') Or !Exists('$(KokoroNativeDir)onnxruntime.dll')"
           Text="kokoro.dll/onnxruntime.dll not found in $(KokoroNativeDir); run packaging/build-natives.ps1 or pass -p:KokoroNativeDir=&lt;dir&gt;" />
  </Target>

</Project>
